# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Public URL of the web app, used in sign-in emails
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Worker: direct Postgres connection (Project Settings → Database → Connection string, session pooler)
DATABASE_URL=
WORKER_POLL_INTERVAL_MS=5000

# Google PageSpeed Insights (Cloud Console → enable "PageSpeed Insights API" → API key). Optional:
# without it audits skip speed tests. Tests the start page (mobile + desktop) and the N most-linked pages (mobile).
PAGESPEED_API_KEY=
PAGESPEED_MAX_PAGES=5

# Google Search Console (same OAuth client as Google sign-in in Supabase).
# Google Cloud: enable "Google Search Console API"; add redirect URI <site>/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32 random bytes, base64: node -e 'console.log(require("crypto").randomBytes(32).toString("base64"))'
TOKEN_ENCRYPTION_KEY=

# Later: AI recommendations
ANTHROPIC_API_KEY=
